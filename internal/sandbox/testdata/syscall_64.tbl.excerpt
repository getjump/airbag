# https://github.com/torvalds/linux/blob/v6.18/arch/x86/entry/syscalls/syscall_64.tbl
# Only the rows for the calls the seccomp filter routes; lines kept verbatim.
# Columns: <number> <abi> <name> <entry point>. abi "common" = x86_64 and x32,
# "64" = x86_64 only, "x32" = x32 only. TestX32SyscallNumbers reads this.
